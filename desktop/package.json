{
  "name": "pulse-desktop",
  "version": "0.2.0",
  "description": "Pulse — branded desktop client for your AI agent workforce",
  "author": {
    "name": "Runstate Ltd",
    "email": "support@runstate.mu"
  },
  "homepage": "https://pulse.runstate.mu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mu.runstate.pulse",
    "productName": "Pulse",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Runstate Ltd <support@runstate.mu>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.10"
  }
}
